@@ -0,0 +1,39 @@
+/**
+ * Module substitutions registered by extensions.
+ *
+ * The loader creates one jiti instance per extension module, so a registration
+ * reaches every extension imported after the registering one and never the
+ * module graph that registered it. Registering a specifier again replaces the
+ * earlier object, so a reloaded extension can register during every load run.
+ */
+
+const registeredModules = new Map<string, unknown>();
+
+function isModuleValue(value: unknown): boolean {
+	return typeof value === "function" || (typeof value === "object" && value !== null);
+}
+
+/**
+ * Register a module object that extensions loaded after the caller receive for `specifier`.
+ *
+ * Call this while the extension loads (module body or factory) to reach every later extension.
+ */
+export function registerExtensionModule(specifier: string, module: unknown): void {
+	if (typeof specifier !== "string" || specifier.trim() === "") {
+		throw new Error("registerExtensionModule requires a non-empty module specifier");
+	}
+	if (!isModuleValue(module)) {
+		throw new Error(`registerExtensionModule("${specifier}") requires a module object or function`);
+	}
+	registeredModules.set(specifier, module);
+}
+
+/** Remove a substitution, so later extensions resolve `specifier` normally again. */
+export function unregisterExtensionModule(specifier: string): void {
+	registeredModules.delete(specifier);
+}
+
+/** Snapshot of the substitutions, merged into the resolution options of each newly loaded extension. */
+export function getRegisteredExtensionModules(): Record<string, unknown> {
+	return Object.fromEntries(registeredModules);
+}
