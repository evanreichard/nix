+/**
+ * Manifest of the package an extension entry file belongs to, for decisions made before the
+ * extension is imported. Stops at the first package.json, so an unrelated ancestor cannot declare
+ * load order for a plain extension directory.
+ */
+export function findPiManifest(entryPath: string): PiManifest | null {
+	let dir = dirname(entryPath);
+	for (let depth = 0; depth < MANIFEST_WALK_DEPTH; depth++) {
+		const packageJsonPath = join(dir, "package.json");
+		if (existsSync(packageJsonPath)) {
+			return readPiManifest(packageJsonPath);
+		}
+		const parent = dirname(dir);
+		if (parent === dir) {
+			return null;
+		}
+		dir = parent;
+	}
+	return null;
+}
