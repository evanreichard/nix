+
+const tempDirs: string[] = [];
+const registeredSpecifiers: string[] = [];
+const cleanups: Array<() => Promise<void> | void> = [];
+
+afterEach(async () => {
+	while (cleanups.length > 0) {
+		await cleanups.pop()?.();
+	}
+	for (const specifier of registeredSpecifiers.splice(0)) {
+		unregisterExtensionModule(specifier);
+	}
+	while (tempDirs.length > 0) {
+		const dir = tempDirs.pop();
+		if (dir && existsSync(dir)) {
+			rmSync(dir, { recursive: true, force: true });
+		}
+	}
+});
+
+function makeTempDir(name: string): string {
+	const dir = join(tmpdir(), `pi-${name}-${Date.now()}-${Math.random().toString(36).slice(2)}`);
+	mkdirSync(dir, { recursive: true });
+	tempDirs.push(dir);
+	return dir;
+}
+
+function writeFile(filePath: string, content: string): void {
+	mkdirSync(join(filePath, ".."), { recursive: true });
+	writeFileSync(filePath, content);
+}
+
+function writePackageExtension(dir: string, manifest: Record<string, unknown>, code: string): string {
+	mkdirSync(dir, { recursive: true });
+	writeFileSync(join(dir, "package.json"), JSON.stringify({ name: "test-extension", pi: manifest }, null, 2));
+	const entryPath = join(dir, "index.ts");
+	writeFileSync(entryPath, code);
+	return entryPath;
+}
+
+function registerModule(specifier: string, module: unknown): void {
+	registerExtensionModule(specifier, module);
+	registeredSpecifiers.push(specifier);
+}
+
+function commandDescription(extension: Extension, name: string): string | undefined {
+	return extension.commands.get(name)?.description;
+}
+
+describe("registerExtensionModule", () => {
+	it("substitutes an imported specifier in extensions loaded afterwards", async () => {
+		const cwd = makeTempDir("ui-host-modules");
+		const providerPath = join(cwd, "provider.ts");
+		const consumerPath = join(cwd, "consumer.ts");
+		writeFile(
+			providerPath,
+			`import { registerExtensionModule } from "@earendil-works/pi-coding-agent";
+registerExtensionModule("mock-transport", { transport: "substituted" });
+export default function (pi) {
+	pi.registerCommand("provider", { description: "provider", handler: () => {} });
+}
+`,
+		);
+		writeFile(
+			consumerPath,
+			`import { transport } from "mock-transport";
+export default function (pi) {
+	pi.registerCommand("consumer", { description: transport, handler: () => {} });
+}
+`,
+		);
+
+		const result = await loadExtensions([providerPath, consumerPath], cwd);
+
+		expect(result.errors).toEqual([]);
+		expect(commandDescription(result.extensions[1], "consumer")).toBe("substituted");
+	});
+
+	it("does not substitute a specifier for the extension that registered it", async () => {
+		const cwd = makeTempDir("ui-host-modules-self");
+		const providerPath = join(cwd, "provider.ts");
+		writeFile(
+			providerPath,
+			`import { registerExtensionModule } from "@earendil-works/pi-coding-agent";
+registerExtensionModule("mock-self", { ok: true });
+export default function (pi) {
+	pi.registerCommand("provider", { description: "provider", handler: () => {} });
+}
+`,
+		);
+
+		const result = await loadExtensions([providerPath], cwd);
+
+		expect(result.errors).toEqual([]);
+		expect(commandDescription(result.extensions[0], "provider")).toBe("provider");
+	});
+
+	it("reaches extensions loaded by later load runs", async () => {
+		const cwd = makeTempDir("ui-host-modules-later");
+		const consumerPath = join(cwd, "consumer.ts");
+		writeFile(
+			consumerPath,
+			`import { transport } from "mock-later";
+export default function (pi) {
+	pi.registerCommand("consumer", { description: transport, handler: () => {} });
+}
+`,
+		);
+
+		registerModule("mock-later", { transport: "later" });
+		const result = await loadExtensions([consumerPath], cwd);
+
+		expect(result.errors).toEqual([]);
+		expect(commandDescription(result.extensions[0], "consumer")).toBe("later");
+	});
+});
+
+describe("UI host extension priority", () => {
+	it("loads manifest-declared UI hosts before other extensions, keeping discovery order", async () => {
+		const cwd = makeTempDir("ui-host-priority");
+		const firstPath = writePackageExtension(
+			join(cwd, "first"),
+			{ extensions: ["index.ts"] },
+			"export default function () {}\n",
+		);
+		const hostPath = writePackageExtension(
+			join(cwd, "host"),
+			{ extensions: ["index.ts"], uiHost: true },
+			"export default function (pi) { pi.registerCommand('host', { description: 'host', handler: () => {} }); }\n",
+		);
+		const lastPath = writePackageExtension(
+			join(cwd, "last"),
+			{ extensions: ["index.ts"] },
+			"export default function () {}\n",
+		);
+
+		const result = await discoverAndLoadExtensions(
+			[join(cwd, "first"), join(cwd, "host"), join(cwd, "last")],
+			cwd,
+			cwd,
+		);
+
+		expect(result.errors).toEqual([]);
+		expect(result.extensions.map((extension) => extension.resolvedPath)).toEqual([hostPath, firstPath, lastPath]);
+		expect(result.extensions[0]?.uiHostDeclared).toBe(true);
+		expect(result.extensions[1]?.uiHostDeclared).toBe(false);
+		expect(result.warnings ?? []).toEqual([]);
+	});
+
+	it("warns when a UI host registers without manifest priority", async () => {
+		const cwd = makeTempDir("ui-host-priority-warning");
+		const firstPath = join(cwd, "first.ts");
+		const hostPath = join(cwd, "host.ts");
+		writeFile(firstPath, "export default function () {}\n");
+		writeFile(
+			hostPath,
+			`export default function (pi) {
+	pi.registerUIHost(async () => ({ notify: () => {} }) as never);
+}
+`,
+		);
+
+		const result = await loadExtensions([firstPath, hostPath], cwd);
+
+		expect(result.errors).toEqual([]);
+		expect(result.extensions.map((extension) => extension.path)).toEqual([firstPath, hostPath]);
+		expect(result.warnings?.map((warning) => warning.path)).toEqual([hostPath]);
+		expect(result.warnings?.[0]?.warning).toContain('"uiHost": true');
+	});
+});
