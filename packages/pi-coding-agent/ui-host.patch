+import type { ImageContent } from "@earendil-works/pi-ai";
+import type { AgentSession } from "../core/agent-session.ts";
+import type { AgentSessionRuntime } from "../core/agent-session-runtime.ts";
+import { stopThemeWatcher } from "./interactive/theme/theme.ts";
+
+export interface HostModeOptions {
+	initialMessage?: string;
+	initialImages?: ImageContent[];
+	initialMessages?: string[];
+	startupBenchmark?: boolean;
+}
+
+export async function runHostMode(runtime: AgentSessionRuntime, options: HostModeOptions): Promise<void> {
+	let finish!: () => void;
+	const shutdown = new Promise<void>((resolve) => {
+		finish = resolve;
+	});
+	let stopped = false;
+	const stop = () => {
+		stopped = true;
+		finish();
+	};
+	let changingSession: Promise<unknown> | undefined;
+	const changeSession = async <T>(operation: () => Promise<T>): Promise<T> => {
+		if (stopped) throw new Error("Pi is shutting down");
+		if (changingSession) throw new Error("A session change is already in progress");
+		const pending = Promise.resolve().then(() => {
+			if (stopped) throw new Error("Pi is shutting down");
+			return operation();
+		});
+		changingSession = pending;
+		try {
+			return await pending;
+		} finally {
+			changingSession = undefined;
+		}
+	};
+	const bind = async (session: AgentSession): Promise<void> => {
+		if (stopped) return;
+		await Promise.race([
+			session.bindExtensions({
+				mode: "tui",
+				shutdownHandler: stop,
+				onError: (error) => console.error(`Extension ${error.extensionPath}: ${error.error}`),
+				commandContextActions: {
+					waitForIdle: () => session.waitForIdle(),
+					newSession: (options) => changeSession(() => runtime.newSession(options)),
+					fork: async (entryId, options) => {
+						const result = await changeSession(() => runtime.fork(entryId, options));
+						return { cancelled: result.cancelled };
+					},
+					navigateTree: async (targetId, options) => {
+						const result = await changeSession(() => session.navigateTree(targetId, options));
+						return { cancelled: result.cancelled };
+					},
+					switchSession: (path, options) => changeSession(() => runtime.switchSession(path, options)),
+					reload: () => changeSession(() => session.reload()),
+				},
+			}),
+			shutdown,
+		]);
+	};
+
+	process.once("SIGINT", stop);
+	process.once("SIGTERM", stop);
+	runtime.setRebindSession(bind);
+	try {
+		await Promise.race([bind(runtime.session), shutdown]);
+		if (stopped || options.startupBenchmark) return;
+		const submitInitialMessages = async (): Promise<void> => {
+			const submit = async (message: string, images?: ImageContent[]): Promise<void> => {
+				try {
+					await runtime.session.prompt(message, images ? { images } : undefined);
+				} catch (error) {
+					console.error(error);
+				}
+			};
+			if (options.initialMessage) await submit(options.initialMessage, options.initialImages);
+			for (const message of options.initialMessages ?? []) {
+				if (stopped) return;
+				await submit(message);
+			}
+		};
+		void submitInitialMessages();
+		await shutdown;
+	} finally {
+		process.off("SIGINT", stop);
+		process.off("SIGTERM", stop);
+		// Replacement Ownership - A replacement may still publish a new session after shutdown was requested; dispose only after its owner has settled.
+		await changingSession?.catch(() => {});
+		runtime.setRebindSession(undefined);
+		try {
+			await runtime.session.abort();
+		} finally {
+			try {
+				await runtime.dispose();
+			} finally {
+				stopThemeWatcher();
+			}
+		}
+	}
+}
