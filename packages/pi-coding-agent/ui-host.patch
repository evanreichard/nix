+describe("runHostMode shutdown and initial input", () => {
+	it("settles an in-flight replacement before SIGTERM disposes the current session", async () => {
+		let bindings: ExtensionBindings | undefined;
+		let rebind: ((session: AgentSession) => Promise<void>) | undefined;
+		let release!: () => void;
+		let started!: () => void;
+		const replacementReady = new Promise<void>((resolve) => {
+			release = resolve;
+		});
+		const replacementStarted = new Promise<void>((resolve) => {
+			started = resolve;
+		});
+		const first = {
+			bindExtensions: vi.fn(async (value: ExtensionBindings) => {
+				bindings = value;
+			}),
+			abort: vi.fn(async () => {}),
+		};
+		const replacement = { bindExtensions: vi.fn(async () => {}), abort: vi.fn(async () => {}) };
+		const disposed: unknown[] = [];
+		const state = {
+			session: first as unknown as AgentSession,
+			setRebindSession(value?: (session: AgentSession) => Promise<void>) {
+				rebind = value;
+			},
+			async newSession() {
+				started();
+				await replacementReady;
+				state.session = replacement as unknown as AgentSession;
+				await rebind?.(replacement as unknown as AgentSession);
+				return { cancelled: false };
+			},
+			async dispose() {
+				disposed.push(state.session);
+			},
+		};
+		const existingSignals = new Set(process.listeners("SIGTERM"));
+		const running = runHostMode(state as unknown as AgentSessionRuntime, {});
+		await vi.waitFor(() => expect(bindings).toBeDefined());
+		const signal = process.listeners("SIGTERM").find((listener) => !existingSignals.has(listener));
+		expect(signal).toBeDefined();
+		cleanups.push(async () => {
+			signal!("SIGTERM");
+			release();
+			await running;
+		});
+		const changing = bindings!.commandContextActions!.newSession();
+		await replacementStarted;
+		signal!("SIGTERM");
+		await new Promise<void>((resolve) => setImmediate(resolve));
+		await expect(bindings!.commandContextActions!.newSession()).rejects.toThrow("shutting down");
+		expect(disposed).toEqual([]);
+		expect(first.abort).not.toHaveBeenCalled();
+		release();
+		await changing;
+		await running;
+		expect(disposed).toEqual([replacement]);
+		expect(replacement.abort).toHaveBeenCalledOnce();
+		expect(replacement.bindExtensions).not.toHaveBeenCalled();
+	});
+
+	it("submits the prepared message and remaining CLI messages sequentially with images only on the first", async () => {
+		let bindings: ExtensionBindings | undefined;
+		let release!: () => void;
+		const firstFinished = new Promise<void>((resolve) => {
+			release = resolve;
+		});
+		const error = vi.spyOn(console, "error").mockImplementation(() => {});
+		cleanups.push(() => {
+			error.mockRestore();
+		});
+		const session = {
+			bindExtensions: vi.fn(async (value: ExtensionBindings) => {
+				bindings = value;
+			}),
+			prompt: vi.fn(async (message: string) => {
+				if (message === "prepared") await firstFinished;
+				if (message === "second") throw new Error("Rejected second message");
+				if (message === "third") bindings!.shutdownHandler!();
+			}),
+			abort: vi.fn(async () => {}),
+		};
+		const runtime = { session, setRebindSession() {}, async dispose() {} };
+		const images = [{ type: "image" as const, mimeType: "image/png", data: "aW1hZ2U=" }];
+		const running = runHostMode(runtime as unknown as AgentSessionRuntime, {
+			initialMessage: "prepared",
+			initialImages: images,
+			initialMessages: ["second", "third", "must-not-run"],
+		});
+		cleanups.push(async () => {
+			release();
+			bindings?.shutdownHandler?.();
+			await running;
+		});
+		await vi.waitFor(() => expect(session.prompt).toHaveBeenCalledTimes(1));
+		expect(session.prompt).toHaveBeenNthCalledWith(1, "prepared", { images });
+		release();
+		await running;
+		expect(session.prompt).toHaveBeenNthCalledWith(2, "second", undefined);
+		expect(session.prompt).toHaveBeenNthCalledWith(3, "third", undefined);
+		expect(session.prompt).toHaveBeenCalledTimes(3);
+		expect(error).toHaveBeenCalledWith(expect.objectContaining({ message: "Rejected second message" }));
+	});
+
+	it("submits positional CLI messages when there is no prepared initial message", async () => {
+		let bindings: ExtensionBindings | undefined;
+		const session = {
+			bindExtensions: vi.fn(async (value: ExtensionBindings) => {
+				bindings = value;
+			}),
+			prompt: vi.fn(async (message: string) => {
+				if (message === "last") bindings!.shutdownHandler!();
+			}),
+			abort: vi.fn(async () => {}),
+		};
+		const runtime = { session, setRebindSession() {}, async dispose() {} };
+		const running = runHostMode(runtime as unknown as AgentSessionRuntime, { initialMessages: ["first", "last"] });
+		cleanups.push(async () => {
+			bindings?.shutdownHandler?.();
+			await running;
+		});
+		await running;
+		expect(session.prompt.mock.calls.map(([message]) => message)).toEqual(["first", "last"]);
+	});
+});
