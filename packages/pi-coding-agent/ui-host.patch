+
+	it("asks the provider again after reload and emits one session_start", async () => {
+		const bound: ExtensionUIContext[] = [];
+		const starts: string[] = [];
+		const { runtime } = await createHostRuntime((pi) => {
+			pi.registerUIHost(() => {
