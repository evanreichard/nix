+describe("runHostMode", () => {
+	function fakeUIContext(selection: string): ExtensionUIContext {
+		// The runner only reaches the members a test exercises; the rest stay absent.
+		return { notify: () => {}, select: async () => selection } as unknown as ExtensionUIContext;
+	}
+
+	async function createHostRuntime(register: (pi: ExtensionAPI) => void): Promise<{ runtime: AgentSessionRuntime }> {
+		const tempDir = makeTempDir("ui-host-mode");
+		const faux = registerFauxProvider();
+		faux.setResponses([fauxAssistantMessage("one")]);
+
+		const authStorage = AuthStorage.inMemory();
+		await authStorage.modify(faux.getModel().provider, async () => ({ type: "api_key", key: "faux-key" }));
+		const modelRuntime = await ModelRuntime.create({
+			credentials: authStorage,
+			modelsPath: join(tempDir, "models.json"),
+		});
+		const model = faux.getModel();
+		modelRuntime.registerProvider(model.provider, {
+			baseUrl: model.baseUrl,
+			api: model.api,
+			models: [
+				{
+					id: model.id,
+					name: model.name,
+					api: model.api,
+					reasoning: model.reasoning,
+					input: model.input,
+					cost: model.cost,
+					contextWindow: model.contextWindow,
+					maxTokens: model.maxTokens,
+					baseUrl: model.baseUrl,
+				},
+			],
+		});
+
+		const createRuntime: CreateAgentSessionRuntimeFactory = async ({ cwd, sessionManager, sessionStartEvent }) => {
+			const services = await createAgentSessionServices({
+				cwd,
+				agentDir: tempDir,
+				modelRuntime,
+				resourceLoaderOptions: {
+					extensionFactories: [
+						(pi) => {
+							register(pi);
+							pi.registerCommand("stop-ui-host", {
+								description: "Stop test host",
+								handler: async (_args, ctx) => ctx.shutdown(),
+							});
+						},
+					],
+					noSkills: true,
+					noPromptTemplates: true,
+					noThemes: true,
+				},
+			});
+			return {
+				...(await createAgentSessionFromServices({
+					services,
+					sessionManager,
+					sessionStartEvent,
+					model: faux.getModel(),
+				})),
+				services,
+				diagnostics: services.diagnostics,
+			};
+		};
+		const runtime = await createAgentSessionRuntime(createRuntime, {
+			cwd: tempDir,
+			agentDir: tempDir,
+			sessionManager: SessionManager.create(tempDir),
+		});
+
+		cleanups.push(async () => {
+			await runtime.dispose();
+			faux.unregister();
+		});
+		return { runtime };
+	}
+
+	async function startHost(runtime: AgentSessionRuntime, initialMessage: string): Promise<void> {
+		let unsubscribe = () => {};
+		const settled = new Promise<void>((resolve) => {
+			unsubscribe = runtime.session.subscribe((event) => {
+				if (event.type === "agent_settled") {
+					unsubscribe();
+					resolve();
+				}
+			});
+		});
+		const running = runHostMode(runtime, { initialMessage });
+		cleanups.push(async () => {
+			await runtime.session.prompt("/stop-ui-host");
+			await running;
+		});
+		await settled;
+	}
+
+	it("binds the provider's context and drives the session without InteractiveMode", async () => {
+		const selections: Array<string | undefined> = [];
+		const { runtime } = await createHostRuntime((pi) => {
+			pi.registerUIHost((context) => {
+				expect(context.session).toBe(runtime.session);
+				expect(typeof context.actions?.newSession).toBe("function");
+				return fakeUIContext("chosen");
+			});
+			pi.on("message_end", async (event, ctx) => {
+				if (event.message.role === "assistant") selections.push(await ctx.ui.select("pick", ["a", "b"]));
+			});
+		});
+
+		expect(findUIHostProvider(runtime.services.resourceLoader.getExtensions().extensions)).toBeDefined();
+		await startHost(runtime, "hello");
+
+		expect(selections).toEqual(["chosen"]);
+		const messages = runtime.session.sessionManager.buildSessionContext().messages;
+		expect(messages.some((message) => message.role === "user")).toBe(true);
+	});
+
+	it("shuts down while another extension is waiting for startup input", async () => {
+		let finishInput: ((value: string | undefined) => void) | undefined;
+		let shutdowns = 0;
+		const { runtime } = await createHostRuntime((pi) => {
+			pi.registerUIHost(() => {
+				const context = fakeUIContext("pending");
+				context.select = () =>
+					new Promise((resolve) => {
+						finishInput = resolve;
+					});
+				return context;
+			});
+			pi.on("session_start", async (_event, ctx) => {
+				const input = ctx.ui.select("Startup input", ["a", "b"]);
+				ctx.shutdown();
+				await input;
+			});
+			pi.on("session_shutdown", async () => {
+				shutdowns++;
+				finishInput?.(undefined);
+			});
+		});
+		await runHostMode(runtime, {});
+		expect(shutdowns).toBe(1);
+	});
+
+	it("asks the provider again for a replacement session", async () => {
+		const bound: ExtensionUIContext[] = [];
+		const { runtime } = await createHostRuntime((pi) => {
+			pi.registerUIHost(() => {
+				const context = fakeUIContext(`context-${bound.length + 1}`);
+				bound.push(context);
+				return context;
+			});
+		});
+
+		await startHost(runtime, "first");
+		expect(bound).toHaveLength(1);
+
+		await runtime.newSession();
+		expect(bound).toHaveLength(2);
