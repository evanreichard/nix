new file mode 100644
index 0000000..085517b
--- /dev/null
+++ w/packages/coding-agent/test/session-bridge.test.ts
@@ -0,0 +1,141 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import {
+	createAgentSessionFromServices,
+	createAgentSessionRuntime,
+	createAgentSessionServices,
+} from "../src/core/agent-session-runtime.ts";
+import type { ExtensionAPI } from "../src/core/extensions/types.ts";
+import type { SessionBridgeContext } from "../src/core/session-bridge.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { SettingsManager } from "../src/core/settings-manager.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+import { initTheme, stopThemeWatcher } from "../src/modes/interactive/theme/theme.ts";
+
+const cleanup: (() => Promise<void> | void)[] = [];
+afterEach(async () => {
+	while (cleanup.length) await cleanup.pop()?.();
+});
+
+async function createMode(register: (pi: ExtensionAPI) => void) {
+	const dir = mkdtempSync(join(tmpdir(), "pi-session-bridge-"));
+	cleanup.push(() => rmSync(dir, { recursive: true, force: true }));
+	const agentDir = join(dir, "agent");
+	const runtime = await createAgentSessionRuntime(
+		async ({ cwd, sessionManager, sessionStartEvent }) => {
+			const services = await createAgentSessionServices({
+				cwd,
+				agentDir,
+				settingsManager: SettingsManager.inMemory({ defaultProjectTrust: "always", quietStartup: true }),
+				resourceLoaderOptions: {
+					extensionFactories: [register],
+					noSkills: true,
+					noPromptTemplates: true,
+					noThemes: true,
+				},
+			});
+			return {
+				...(await createAgentSessionFromServices({ services, sessionManager, sessionStartEvent, noTools: "all" })),
+				services,
+				diagnostics: services.diagnostics,
+			};
+		},
+		{ cwd: dir, agentDir, sessionManager: SessionManager.create(dir) },
+	);
+	initTheme("dark", false);
+	const terminal = new VirtualTerminal(100, 30);
+	const mode = new InteractiveMode(runtime, { terminal });
+	cleanup.push(async () => {
+		mode.stop();
+		await runtime.dispose();
+		stopThemeWatcher();
+	});
+	await mode.init();
+	return { runtime, terminal, mode };
+}
+
+describe("session bridges", () => {
+	it("keeps the stock interactive mode, editor, footer, and session while attaching a companion", async () => {
+		const contexts: SessionBridgeContext[] = [];
+		const starts: string[] = [];
+		const { runtime, terminal } = await createMode((pi) => {
+			pi.registerSessionBridge((context) => {
+				contexts.push(context);
+			});
+			pi.on("session_start", (event, ctx) => {
+				starts.push(event.reason);
+				ctx.ui.setFooter(() => ({ render: () => ["stock footer still works"], invalidate() {} }));
+			});
+		});
+		expect(contexts).toHaveLength(1);
+		expect(contexts[0].session).toBe(runtime.session);
+		expect(starts).toEqual(["startup"]);
+		const bridge = contexts[0].terminal;
+		bridge.setEditorText("same editor");
+		expect(bridge.getEditorText()).toBe("same editor");
+		expect(
+			bridge
+				.getComponents()
+				.find((value) => value.placement === "footer")
+				?.component.render(100),
+		).toEqual(["stock footer still works"]);
+		await terminal.waitForRender();
+		expect(terminal.getViewport().join("\n")).toContain("stock footer still works");
+	});
+
+	it("rebinds the bridge before reload session_start and preserves the stock base UI", async () => {
+		const contexts: SessionBridgeContext[] = [];
+		const wrappedNotify: unknown[] = [];
+		const starts: number[] = [];
+		await createMode((pi) => {
+			pi.registerSessionBridge((context) => {
+				contexts.push(context);
+				const notify = (...args: Parameters<typeof context.ui.notify>) => context.ui.notify(...args);
+				wrappedNotify.push(notify);
+				return { ...context.ui, notify };
+			});
+			pi.on("session_start", () => {
+				starts.push(contexts.length);
+			});
+		});
+		const first = contexts[0];
+		await first.actions.reload();
+		expect(starts).toEqual([1, 2]);
+		expect(contexts).toHaveLength(2);
+		expect(contexts[1].ui.notify).not.toBe(wrappedNotify[0]);
+		expect(contexts[1].session).toBe(first.session);
+	});
+
+	it("uses the replacement session instead of retaining the previous bridge", async () => {
+		const contexts: SessionBridgeContext[] = [];
+		const { runtime } = await createMode((pi) => {
+			pi.registerSessionBridge((context) => {
+				contexts.push(context);
+			});
+		});
+		const first = runtime.session;
+		await contexts[0].actions.newSession();
+		expect(contexts).toHaveLength(2);
+		expect(contexts[1].session).toBe(runtime.session);
+		expect(runtime.session).not.toBe(first);
+	});
+
+	it("reports a failed companion without aborting other extension startup or the TUI", async () => {
+		let starts = 0;
+		const { terminal } = await createMode((pi) => {
+			pi.registerSessionBridge(() => {
+				throw new Error("companion failed");
+			});
+			pi.on("session_start", (_event, ctx) => {
+				starts++;
+				ctx.ui.setEditorText("still interactive");
+			});
+		});
+		expect(starts).toBe(1);
+		await terminal.waitForRender();
+		expect(terminal.getViewport().join("\n")).toContain("still interactive");
+	});
+});
