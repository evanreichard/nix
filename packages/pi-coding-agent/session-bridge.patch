+import type { Component } from "@earendil-works/pi-tui";
+import type { AgentSession } from "./agent-session.ts";
+import type { ExtensionCommandContextActions, ExtensionUIContext } from "./extensions/types.ts";
+
+export const SESSION_BRIDGE_API_VERSION = 1;
+
+export interface SessionBridgeComponent {
+	component: Component;
+	placement: "header" | "aboveEditor" | "belowEditor" | "footer" | "dialog";
+	title?: string;
+}
+
+export interface SessionBridgeTerminal {
+	readonly columns: number;
+	getComponents(): SessionBridgeComponent[];
+	getEditorText(): string;
+	setEditorText(text: string): void;
+	submit(text: string): Promise<void>;
+	dispatchInput(component: Component, data: string): void;
+	notify(message: string, level?: "info" | "warning" | "error"): void;
+	requestRender(): void;
+	subscribe(listener: () => void): () => void;
+	getCompactionQueue(): { text: string; mode: "steer" | "followUp" }[];
+	queueChanged(): void;
+}
+
+export interface SessionBridgeContext {
+	readonly session: AgentSession;
+	readonly actions: ExtensionCommandContextActions;
+	readonly ui: ExtensionUIContext;
+	readonly terminal: SessionBridgeTerminal;
+}
+
+/** Attach to the existing interactive session; an optional return value wraps extension UI without replacing the terminal. */
+export type SessionBridgeFactory = (context: SessionBridgeContext) => ExtensionUIContext | undefined;
